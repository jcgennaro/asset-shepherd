FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_PROGRESS=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv==0.8.22

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen --no-dev


FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm AS runtime-base

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        chromium \
        fonts-dejavu-core \
        fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 asset-shepherd

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --chown=asset-shepherd:asset-shepherd src ./src

ENV ASSET_SHEPHERD_CHROMIUM_PATH=/usr/bin/chromium \
    PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

USER asset-shepherd
EXPOSE 8080


FROM runtime-base AS web
CMD ["sh", "-c", "exec uvicorn asset_shepherd.web:app --host 0.0.0.0 --port ${PORT:-8080}"]


FROM runtime-base AS agentcore
ENV ASSET_SHEPHERD_CHROMIUM_DISABLE_SANDBOX=1
CMD ["opentelemetry-instrument", "python", "-m", "asset_shepherd.agentcore_runtime"]
