{
  "$id": "https://asset-shepherd.dev/schemas/v1/agent_candidate_reassessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Model judgment after comparing standardized source and candidate views.",
  "properties": {
    "candidate_satisfies_assessment": {
      "title": "Candidate Satisfies Assessment",
      "type": "boolean"
    },
    "candidate_views_used": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Views Used",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "maxLength": 500,
        "minLength": 4,
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "initiating_tool_call_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initiating Tool Call Id"
    },
    "reassessment_id": {
      "pattern": "^reassessment-[0-9a-f]{16}-v1$",
      "title": "Reassessment Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_assessment_id": {
      "pattern": "^assessment-[0-9a-f]{16}-v1$",
      "title": "Source Assessment Id",
      "type": "string"
    },
    "source_views_used": {
      "items": {
        "type": "string"
      },
      "title": "Source Views Used",
      "type": "array"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 12,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "reassessment_id",
    "source_assessment_id",
    "candidate_satisfies_assessment",
    "summary",
    "evidence",
    "confidence",
    "source_views_used",
    "candidate_views_used"
  ],
  "title": "AgentCandidateReassessment",
  "type": "object"
}
