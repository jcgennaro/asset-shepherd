{
  "$defs": {
    "AssetTargetUse": {
      "description": "User-confirmed destination for the uploaded asset.",
      "enum": [
        "STATIC_GAME_ASSET",
        "RIG_READY_CHARACTER",
        "PLAYABLE_CHARACTER"
      ],
      "title": "AssetTargetUse",
      "type": "string"
    }
  },
  "$id": "https://asset-shepherd.dev/schemas/v1/asset_intent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable user-confirmed target story bound to one inspection job.",
  "properties": {
    "canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Sha256",
      "type": "string"
    },
    "confirmed_at": {
      "format": "date-time",
      "title": "Confirmed At",
      "type": "string"
    },
    "confirmed_story": {
      "maxLength": 1000,
      "minLength": 20,
      "title": "Confirmed Story",
      "type": "string"
    },
    "expected_piece_count": {
      "default": 1,
      "maximum": 64,
      "minimum": 1,
      "title": "Expected Piece Count",
      "type": "integer"
    },
    "expected_piece_count_evidence": {
      "default": "A single asset is normally expected as one semantic piece.",
      "maxLength": 160,
      "minLength": 1,
      "title": "Expected Piece Count Evidence",
      "type": "string"
    },
    "intent_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Intent Id",
      "type": "string"
    },
    "intent_version": {
      "default": 2,
      "enum": [
        1,
        2
      ],
      "title": "Intent Version",
      "type": "integer"
    },
    "original_description": {
      "maxLength": 600,
      "minLength": 12,
      "title": "Original Description",
      "type": "string"
    },
    "target_height_cm": {
      "exclusiveMinimum": 0.0,
      "maximum": 100000.0,
      "title": "Target Height Cm",
      "type": "number"
    },
    "target_use": {
      "$ref": "#/$defs/AssetTargetUse"
    }
  },
  "required": [
    "intent_id",
    "original_description",
    "target_use",
    "target_height_cm",
    "confirmed_story",
    "confirmed_at",
    "canonical_sha256"
  ],
  "title": "AssetIntentProvenance",
  "type": "object"
}
