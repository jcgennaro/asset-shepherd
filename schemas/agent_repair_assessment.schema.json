{
  "$defs": {
    "AgentDisposition": {
      "description": "The workflow agent's evidence-backed next-step judgment.",
      "enum": [
        "ACCEPT",
        "REPAIR",
        "REPORT_ONLY",
        "NEEDS_CLARIFICATION",
        "RETURN_TO_CREATION_TOOL"
      ],
      "title": "AgentDisposition",
      "type": "string"
    }
  },
  "$id": "https://asset-shepherd.dev/schemas/v1/agent_repair_assessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One model-authored assessment bound to objective observations and a confirmed target.",
  "properties": {
    "assessment_id": {
      "pattern": "^assessment-[0-9a-f]{16}-v1$",
      "title": "Assessment Id",
      "type": "string"
    },
    "clean_degenerate_geometry": {
      "default": false,
      "title": "Clean Degenerate Geometry",
      "type": "boolean"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "disposition": {
      "$ref": "#/$defs/AgentDisposition"
    },
    "evidence": {
      "items": {
        "maxLength": 500,
        "minLength": 4,
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "ground_to_y_zero": {
      "default": false,
      "title": "Ground To Y Zero",
      "type": "boolean"
    },
    "initiating_tool_call_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initiating Tool Call Id"
    },
    "pivot_anchor_id": {
      "anyOf": [
        {
          "pattern": "^pivot-anchor-[0-9a-f]{16}-v1$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pivot Anchor Id"
    },
    "pivot_anchor_label": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pivot Anchor Label"
    },
    "pivot_anchor_position_m": {
      "anyOf": [
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pivot Anchor Position M"
    },
    "pivot_target": {
      "default": "PRESERVE",
      "enum": [
        "PRESERVE",
        "BOUNDS_CENTER",
        "FOOTPRINT_CENTER_BOTTOM",
        "MEASURED_ANCHOR"
      ],
      "title": "Pivot Target",
      "type": "string"
    },
    "remove_component_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Remove Component Ids",
      "type": "array"
    },
    "rename_invalid_display_names": {
      "default": false,
      "title": "Rename Invalid Display Names",
      "type": "boolean"
    },
    "rotation_axis": {
      "anyOf": [
        {
          "enum": [
            "X",
            "Y",
            "Z"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rotation Axis"
    },
    "rotation_degrees": {
      "default": 0,
      "enum": [
        -180,
        -90,
        0,
        90,
        180
      ],
      "title": "Rotation Degrees",
      "type": "integer"
    },
    "scale_to_confirmed_height": {
      "default": false,
      "title": "Scale To Confirmed Height",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "semantic_height_axis": {
      "anyOf": [
        {
          "enum": [
            "X",
            "Y",
            "Z"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Height Axis"
    },
    "source_views_used": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Views Used",
      "type": "array"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 12,
      "title": "Summary",
      "type": "string"
    },
    "weld_identical_vertices": {
      "default": false,
      "title": "Weld Identical Vertices",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "disposition",
    "summary",
    "evidence",
    "confidence"
  ],
  "title": "AgentRepairAssessment",
  "type": "object"
}
