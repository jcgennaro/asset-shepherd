          "type": "array"
        }
      },
      "required": [
        "before_bounds",
        "proposed_matrix",
        "expected_after_bounds",
        "components",
        "consequence_summary"
      ],
      "title": "NormalizationPayload",
      "type": "object"
    },
    "RenamePayload": {
      "additionalProperties": false,
      "description": "Parameters for an index-preserving display-name repair.",
      "properties": {
        "after_name": {
          "title": "After Name",
          "type": "string"
        },
        "before_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Name"
        },
        "component_index": {
          "minimum": 0,
          "title": "Component Index",
          "type": "integer"
        },
        "component_type": {
          "enum": [
            "node",
            "mesh"
          ],
          "title": "Component Type",
          "type": "string"
        },
        "payload_type": {
          "const": "rename",
          "default": "rename",
          "title": "Payload Type",
          "type": "string"
        }
      },
      "required": [
        "component_type",
        "component_index",
        "before_name",
        "after_name"
      ],
      "title": "RenamePayload",
      "type": "object"
    },
    "RepairKind": {
      "description": "Registered version-1 repair operations.",
      "enum": [
        "RENAME_NODE",
        "RENAME_MESH",
        "NORMALIZATION_TRANSFORM",
        "WELD_IDENTICAL_VERTICES"
      ],
      "title": "RepairKind",
      "type": "string"
    },
    "WeldPayload": {
      "additionalProperties": false,
      "description": "Typed request to merge only byte-identical complete vertex tuples.",
      "properties": {
        "consequence_summary": {
          "title": "Consequence Summary",
          "type": "string"
        },
        "payload_type": {
          "const": "weld_identical_vertices",
          "default": "weld_identical_vertices",
          "title": "Payload Type",
          "type": "string"
        },
        "primitives": {
          "items": {
            "$ref": "#/$defs/WeldPrimitivePayload"
          },
          "title": "Primitives",
          "type": "array"
        },
        "protected_attributes": {
          "items": {
            "type": "string"
          },
          "title": "Protected Attributes",
          "type": "array"
        },
        "tolerance_m": {
          "default": 0.0,
          "maximum": 0.0,
          "minimum": 0.0,
          "title": "Tolerance M",
          "type": "number"
        }
      },
      "required": [
        "primitives",
        "protected_attributes",
        "consequence_summary"
      ],
      "title": "WeldPayload",
      "type": "object"
    },
    "WeldPrimitivePayload": {
      "additionalProperties": false,
      "description": "Expected effect of one exact, attribute-preserving primitive weld.",
      "properties": {
        "after_position_count": {
          "exclusiveMinimum": 0,
          "title": "After Position Count",
          "type": "integer"
        },
        "before_position_count": {
          "exclusiveMinimum": 0,
          "title": "Before Position Count",
          "type": "integer"
        },
        "merge_count": {
          "exclusiveMinimum": 0,
          "title": "Merge Count",
          "type": "integer"
        },
        "mesh_index": {
          "minimum": 0,
          "title": "Mesh Index",
          "type": "integer"
        },
        "primitive_index": {
          "minimum": 0,
          "title": "Primitive Index",
          "type": "integer"
        }
      },
      "required": [
        "mesh_index",
        "primitive_index",
        "before_position_count",
        "after_position_count",
        "merge_count"
      ],
      "title": "WeldPrimitivePayload",
      "type": "object"
    }
  },
  "$id": "https://asset-shepherd.dev/schemas/v1/repair_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic set of version-1 repair candidates.",
  "properties": {
    "agent_assessment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Assessment Id"
    },
    "approval_action_ids": {
      "items": {
        "type": "string"
      },
      "title": "Approval Action Ids",
      "type": "array"
    },
    "auto_action_ids": {
      "items": {
        "type": "string"
      },
      "title": "Auto Action Ids",
      "type": "array"
    },
    "blocked": {
      "title": "Blocked",
      "type": "boolean"
    },
    "blocked_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocked Reasons",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateRepair"
      },
      "title": "Candidates",
      "type": "array"
    },
    "inspection_id": {
      "title": "Inspection Id",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "planning_authority": {
      "default": "LEGACY_DETERMINISTIC",
      "enum": [
        "LEGACY_DETERMINISTIC",
        "AGENT_ORCHESTRATED"
      ],
      "title": "Planning Authority",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "const": 1,
      "title": "Profile Version",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "inspection_id",
    "source_sha256",
    "profile_id",
    "profile_version",
    "candidates",
    "auto_action_ids",
    "approval_action_ids",
    "blocked",
    "blocked_reasons"
  ],
  "title": "RepairPlan",
  "type": "object"
}
