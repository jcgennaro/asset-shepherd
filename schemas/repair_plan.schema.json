{
  "$defs": {
    "ActionClass": {
      "description": "Authorization class for a finding or candidate repair.",
      "enum": [
        "REPORT_ONLY",
        "AUTO_SAFE",
        "APPROVAL_REQUIRED",
        "BLOCKED"
      ],
      "title": "ActionClass",
      "type": "string"
    },
    "Bounds3D": {
      "additionalProperties": false,
      "description": "World-space bounds represented in meters and centimeters.",
      "properties": {
        "dimensions_cm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Dimensions Cm",
          "type": "array"
        },
        "dimensions_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Dimensions M",
          "type": "array"
        },
        "maximum_cm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Maximum Cm",
          "type": "array"
        },
        "maximum_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Maximum M",
          "type": "array"
        },
        "minimum_cm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Minimum Cm",
          "type": "array"
        },
        "minimum_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Minimum M",
          "type": "array"
        }
      },
      "required": [
        "minimum_m",
        "maximum_m",
        "dimensions_m",
        "minimum_cm",
        "maximum_cm",
        "dimensions_cm"
      ],
      "title": "Bounds3D",
      "type": "object"
    },
    "CandidateRepair": {
      "additionalProperties": false,
      "description": "A registered repair derived from one or more findings.",
      "properties": {
        "action_class": {
          "$ref": "#/$defs/ActionClass"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RepairKind"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "normalization": "#/$defs/NormalizationPayload",
              "rename": "#/$defs/RenamePayload",
              "weld_identical_vertices": "#/$defs/WeldPayload"
            },
            "propertyName": "payload_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RenamePayload"
            },
            {
              "$ref": "#/$defs/NormalizationPayload"
            },
            {
              "$ref": "#/$defs/WeldPayload"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "id",
        "kind",
        "action_class",
        "finding_ids",
        "description",
        "payload"
      ],
      "title": "CandidateRepair",
      "type": "object"
    },
    "NormalizationComponent": {
      "additionalProperties": false,
      "description": "Evidence for one component of a combined normalization transform.",
      "properties": {
        "component": {
          "enum": [
            "scale",
            "orientation",
            "grounding",
            "pivot"
          ],
          "title": "Component",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "component",
        "evidence",
        "confidence"
      ],
      "title": "NormalizationComponent",
      "type": "object"
    },
    "NormalizationPayload": {
      "additionalProperties": false,
      "description": "Parameters and consequences for the approval-required root transform.",
      "properties": {
        "application_mode": {
          "default": "ADD_ROOT",
          "enum": [
            "ADD_ROOT",
            "COMPOSE_EXISTING_ROOT"
          ],
          "title": "Application Mode",
          "type": "string"
        },
        "before_bounds": {
          "$ref": "#/$defs/Bounds3D"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/NormalizationComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "consequence_summary": {
          "title": "Consequence Summary",
          "type": "string"
        },
        "existing_root_after_matrix": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "maxItems": 4,
                  "minItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 4,
                  "minItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 4,
                  "minItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 4,
                  "minItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Existing Root After Matrix"
        },
        "existing_root_before_matrix": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "maxItems": 4,
                  "minItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 4,
                  "minItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 4,
                  "minItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 4,
                  "minItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Existing Root Before Matrix"
        },
        "existing_root_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Existing Root Index"
        },
        "expected_after_bounds": {
          "$ref": "#/$defs/Bounds3D"
        },
        "payload_type": {
          "const": "normalization",
          "default": "normalization",
          "title": "Payload Type",
          "type": "string"
        },
        "pivot_target": {
          "default": "PRESERVE",
          "enum": [
            "PRESERVE",
            "BOUNDS_CENTER",
            "FOOTPRINT_CENTER_BOTTOM"
          ],
          "title": "Pivot Target",
          "type": "string"
        },
        "proposed_matrix": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
