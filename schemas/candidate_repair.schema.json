    "RenamePayload": {
      "additionalProperties": false,
      "description": "Parameters for an index-preserving display-name repair.",
      "properties": {
        "after_name": {
          "title": "After Name",
          "type": "string"
        },
        "before_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Name"
        },
        "component_index": {
          "minimum": 0,
          "title": "Component Index",
          "type": "integer"
        },
        "component_type": {
          "enum": [
            "node",
            "mesh"
          ],
          "title": "Component Type",
          "type": "string"
        },
        "payload_type": {
          "const": "rename",
          "default": "rename",
          "title": "Payload Type",
          "type": "string"
        }
      },
      "required": [
        "component_type",
        "component_index",
        "before_name",
        "after_name"
      ],
      "title": "RenamePayload",
      "type": "object"
    },
    "RepairKind": {
      "description": "Registered version-1 repair operations.",
      "enum": [
        "RENAME_NODE",
        "RENAME_MESH",
        "NORMALIZATION_TRANSFORM",
        "WELD_IDENTICAL_VERTICES",
        "CLEAN_DEGENERATE_GEOMETRY",
        "REMOVE_DISCONNECTED_COMPONENTS",
        "SIMPLIFY_MESH"
      ],
      "title": "RepairKind",
      "type": "string"
    },
    "WeldPayload": {
      "additionalProperties": false,
      "description": "Typed request to merge only byte-identical complete vertex tuples.",
      "properties": {
        "consequence_summary": {
          "title": "Consequence Summary",
          "type": "string"
        },
        "payload_type": {
          "const": "weld_identical_vertices",
          "default": "weld_identical_vertices",
          "title": "Payload Type",
          "type": "string"
        },
        "primitives": {
          "items": {
            "$ref": "#/$defs/WeldPrimitivePayload"
          },
          "title": "Primitives",
          "type": "array"
        },
        "protected_attributes": {
          "items": {
            "type": "string"
          },
          "title": "Protected Attributes",
          "type": "array"
        },
        "tolerance_m": {
          "default": 0.0,
          "maximum": 0.0,
          "minimum": 0.0,
          "title": "Tolerance M",
          "type": "number"
        }
      },
      "required": [
        "primitives",
        "protected_attributes",
        "consequence_summary"
      ],
      "title": "WeldPayload",
      "type": "object"
    },
    "WeldPrimitivePayload": {
      "additionalProperties": false,
      "description": "Expected effect of one exact, attribute-preserving primitive weld.",
      "properties": {
        "after_position_count": {
          "exclusiveMinimum": 0,
          "title": "After Position Count",
          "type": "integer"
        },
        "before_position_count": {
          "exclusiveMinimum": 0,
          "title": "Before Position Count",
          "type": "integer"
        },
        "merge_count": {
          "exclusiveMinimum": 0,
          "title": "Merge Count",
          "type": "integer"
        },
        "mesh_index": {
          "minimum": 0,
          "title": "Mesh Index",
          "type": "integer"
        },
        "primitive_index": {
          "minimum": 0,
          "title": "Primitive Index",
          "type": "integer"
        }
      },
      "required": [
        "mesh_index",
        "primitive_index",
        "before_position_count",
        "after_position_count",
        "merge_count"
      ],
      "title": "WeldPrimitivePayload",
      "type": "object"
    }
  },
  "$id": "https://asset-shepherd.dev/schemas/v1/candidate_repair.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A registered repair derived from one or more findings.",
  "properties": {
    "action_class": {
      "$ref": "#/$defs/ActionClass"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "finding_ids": {
      "items": {
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/RepairKind"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "clean_degenerate_geometry": "#/$defs/DegenerateGeometryPayload",
          "normalization": "#/$defs/NormalizationPayload",
          "remove_disconnected_components": "#/$defs/ComponentRemovalPayload",
          "rename": "#/$defs/RenamePayload",
          "simplify_mesh": "#/$defs/MeshSimplificationPayload",
          "weld_identical_vertices": "#/$defs/WeldPayload"
        },
        "propertyName": "payload_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RenamePayload"
        },
        {
          "$ref": "#/$defs/NormalizationPayload"
        },
        {
          "$ref": "#/$defs/WeldPayload"
        },
        {
          "$ref": "#/$defs/DegenerateGeometryPayload"
        },
        {
          "$ref": "#/$defs/ComponentRemovalPayload"
        },
        {
          "$ref": "#/$defs/MeshSimplificationPayload"
        }
      ],
      "title": "Payload"
    }
