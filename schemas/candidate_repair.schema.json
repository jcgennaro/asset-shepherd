{
  "$defs": {
    "ActionClass": {
      "description": "Authorization class for a finding or candidate repair.",
      "enum": [
        "REPORT_ONLY",
        "AUTO_SAFE",
        "APPROVAL_REQUIRED",
        "BLOCKED"
      ],
      "title": "ActionClass",
      "type": "string"
    },
    "Bounds3D": {
      "additionalProperties": false,
      "description": "World-space bounds represented in meters and centimeters.",
      "properties": {
        "dimensions_cm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Dimensions Cm",
          "type": "array"
        },
        "dimensions_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Dimensions M",
          "type": "array"
        },
        "maximum_cm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Maximum Cm",
          "type": "array"
        },
        "maximum_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Maximum M",
          "type": "array"
        },
        "minimum_cm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Minimum Cm",
          "type": "array"
        },
        "minimum_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Minimum M",
          "type": "array"
        }
      },
      "required": [
        "minimum_m",
        "maximum_m",
        "dimensions_m",
        "minimum_cm",
        "maximum_cm",
        "dimensions_cm"
      ],
      "title": "Bounds3D",
      "type": "object"
    },
    "ComponentRemovalPayload": {
      "additionalProperties": false,
      "description": "Typed request to remove only explicitly approved disconnected components.",
      "properties": {
        "consequence_summary": {
          "title": "Consequence Summary",
          "type": "string"
        },
        "payload_type": {
          "const": "remove_disconnected_components",
          "default": "remove_disconnected_components",
          "title": "Payload Type",
          "type": "string"
        },
        "primitives": {
          "items": {
            "$ref": "#/$defs/ComponentRemovalPrimitivePayload"
          },
          "title": "Primitives",
          "type": "array"
        }
      },
      "required": [
        "primitives",
        "consequence_summary"
      ],
      "title": "ComponentRemovalPayload",
      "type": "object"
    },
    "ComponentRemovalPrimitivePayload": {
      "additionalProperties": false,
      "description": "Exact component membership and triangle delta for one primitive selection.",
      "properties": {
        "after_triangle_count": {
          "exclusiveMinimum": 0,
          "title": "After Triangle Count",
          "type": "integer"
        },
        "before_triangle_count": {
          "exclusiveMinimum": 0,
          "title": "Before Triangle Count",
          "type": "integer"
        },
        "mesh_index": {
          "minimum": 0,
          "title": "Mesh Index",
          "type": "integer"
        },
        "primitive_index": {
          "minimum": 0,
          "title": "Primitive Index",
          "type": "integer"
        },
        "removed_component_ids": {
          "items": {
            "type": "string"
          },
          "title": "Removed Component Ids",
          "type": "array"
        },
        "removed_triangle_count": {
          "exclusiveMinimum": 0,
          "title": "Removed Triangle Count",
          "type": "integer"
        },
        "retained_component_ids": {
          "items": {
            "type": "string"
          },
          "title": "Retained Component Ids",
          "type": "array"
        }
      },
      "required": [
        "mesh_index",
        "primitive_index",
        "before_triangle_count",
        "after_triangle_count",
        "removed_triangle_count",
        "removed_component_ids",
        "retained_component_ids"
      ],
      "title": "ComponentRemovalPrimitivePayload",
      "type": "object"
    },
    "DegenerateGeometryPayload": {
      "additionalProperties": false,
      "description": "Typed request for zero-area triangle removal and exact unused-tuple compaction.",
      "properties": {
        "consequence_summary": {
          "title": "Consequence Summary",
          "type": "string"
        },
        "payload_type": {
          "const": "clean_degenerate_geometry",
          "default": "clean_degenerate_geometry",
          "title": "Payload Type",
          "type": "string"
        },
        "primitives": {
          "items": {
            "$ref": "#/$defs/DegenerateGeometryPrimitivePayload"
          },
          "title": "Primitives",
          "type": "array"
        }
      },
      "required": [
        "primitives",
        "consequence_summary"
      ],
      "title": "DegenerateGeometryPayload",
      "type": "object"
    },
    "DegenerateGeometryPrimitivePayload": {
      "additionalProperties": false,
      "description": "Exact, independently measurable effect for one narrow geometry cleanup.",
      "properties": {
        "after_position_count": {
          "exclusiveMinimum": 0,
          "title": "After Position Count",
          "type": "integer"
        },
        "after_triangle_count": {
          "exclusiveMinimum": 0,
          "title": "After Triangle Count",
          "type": "integer"
        },
        "before_position_count": {
          "exclusiveMinimum": 0,
          "title": "Before Position Count",
          "type": "integer"
        },
        "before_triangle_count": {
          "exclusiveMinimum": 0,
          "title": "Before Triangle Count",
          "type": "integer"
        },
        "mesh_index": {
          "minimum": 0,
          "title": "Mesh Index",
          "type": "integer"
        },
        "primitive_index": {
          "minimum": 0,
          "title": "Primitive Index",
          "type": "integer"
        },
        "removed_degenerate_triangle_count": {
          "minimum": 0,
          "title": "Removed Degenerate Triangle Count",
          "type": "integer"
        },
        "removed_unused_position_count": {
          "minimum": 0,
          "title": "Removed Unused Position Count",
          "type": "integer"
        }
      },
      "required": [
        "mesh_index",
        "primitive_index",
        "before_triangle_count",
        "after_triangle_count",
        "removed_degenerate_triangle_count",
        "before_position_count",
        "after_position_count",
        "removed_unused_position_count"
      ],
      "title": "DegenerateGeometryPrimitivePayload",
      "type": "object"
    },
    "MeshSimplificationPayload": {
      "additionalProperties": false,
      "description": "Typed request for controlled, attribute-preserving mesh simplification.",
      "properties": {
        "consequence_summary": {
          "title": "Consequence Summary",
          "type": "string"
        },
        "maximum_bounds_drift_fraction": {
          "default": 0.02,
          "exclusiveMinimum": 0.0,
          "maximum": 0.02,
          "title": "Maximum Bounds Drift Fraction",
          "type": "number"
        },
        "payload_type": {
          "const": "simplify_mesh",
          "default": "simplify_mesh",
          "title": "Payload Type",
          "type": "string"
        },
        "primitives": {
          "items": {
            "$ref": "#/$defs/MeshSimplificationPrimitivePayload"
          },
          "title": "Primitives",
          "type": "array"
        },
        "protected_component_triangle_threshold": {
          "default": 1000,
          "exclusiveMinimum": 0,
          "title": "Protected Component Triangle Threshold",
          "type": "integer"
        },
        "source_triangle_count": {
          "exclusiveMinimum": 0,
          "title": "Source Triangle Count",
          "type": "integer"
        },
        "target_error": {
          "exclusiveMinimum": 0.0,
          "maximum": 0.1,
          "title": "Target Error",
          "type": "number"
        },
        "target_triangle_count": {
          "exclusiveMinimum": 0,
          "title": "Target Triangle Count",
          "type": "integer"
        }
      },
      "required": [
        "source_triangle_count",
        "target_triangle_count",
        "target_error",
        "primitives",
        "consequence_summary"
      ],
      "title": "MeshSimplificationPayload",
      "type": "object"
    },
    "MeshSimplificationPrimitivePayload": {
      "additionalProperties": false,
      "description": "Approved triangle target and protections for one simplifiable primitive.",
      "properties": {
        "before_triangle_count": {
          "exclusiveMinimum": 0,
          "title": "Before Triangle Count",
          "type": "integer"
        },
        "mesh_index": {
          "minimum": 0,
          "title": "Mesh Index",
          "type": "integer"
        },
        "primitive_index": {
          "minimum": 0,
          "title": "Primitive Index",
          "type": "integer"
        },
        "protected_component_count": {
          "minimum": 0,
          "title": "Protected Component Count",
          "type": "integer"
        },
        "protected_triangle_count": {
          "minimum": 0,
          "title": "Protected Triangle Count",
          "type": "integer"
        },
        "target_triangle_count": {
          "exclusiveMinimum": 0,
          "title": "Target Triangle Count",
          "type": "integer"
        }
      },
      "required": [
        "mesh_index",
        "primitive_index",
        "before_triangle_count",
        "target_triangle_count",
        "protected_component_count",
        "protected_triangle_count"
      ],
      "title": "MeshSimplificationPrimitivePayload",
      "type": "object"
    },
    "NormalizationComponent": {
      "additionalProperties": false,
      "description": "Evidence for one component of a combined normalization transform.",
      "properties": {
        "component": {
          "enum": [
            "scale",
            "orientation",
            "grounding",
            "pivot"
          ],
          "title": "Component",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "component",
        "evidence",
        "confidence"
      ],
      "title": "NormalizationComponent",
      "type": "object"
    },
