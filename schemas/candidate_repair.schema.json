        },
        "payload_type": {
          "const": "normalization",
          "default": "normalization",
          "title": "Payload Type",
          "type": "string"
        },
        "pivot_anchor_id": {
          "anyOf": [
            {
              "pattern": "^pivot-anchor-[0-9a-f]{16}-v1$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pivot Anchor Id"
        },
        "pivot_anchor_label": {
