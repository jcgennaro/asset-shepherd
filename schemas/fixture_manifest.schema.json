  "$id": "https://asset-shepherd.dev/schemas/v1/fixture_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Known facts and intended defects for a generated test fixture.",
  "properties": {
    "expected_bounds_m": {
      "$ref": "#/$defs/Bounds3D"
    },
    "expected_defect_codes": {
      "items": {
        "type": "string"
