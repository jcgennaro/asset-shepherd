      "type": "integer"
    },
    "expected_triangle_count": {
      "minimum": 0,
      "title": "Expected Triangle Count",
      "type": "integer"
    },
    "expected_vertex_count": {
      "minimum": 0,
      "title": "Expected Vertex Count",
      "type": "integer"
    },
    "fixture_id": {
      "title": "Fixture Id",
      "type": "string"
    },
    "fixture_version": {
      "const": 1,
      "default": 1,
      "title": "Fixture Version",
      "type": "integer"
    },
    "glb_filename": {
      "title": "Glb Filename",
      "type": "string"
    },
    "original_asset": {
      "title": "Original Asset",
      "type": "boolean"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    }
