        "enum": [
          "APPROVE",
          "REJECT"
        ],
        "type": "string"
      },
      "title": "Options",
      "type": "array"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "proposed_matrix": {
      "anyOf": [
        {
