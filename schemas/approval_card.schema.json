  "$id": "https://asset-shepherd.dev/schemas/v1/approval_card.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON-serializable human decision card for one consequential operation.",
  "properties": {
    "before_bounds": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bounds3D"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "before_target_extent_m": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Before Target Extent M"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "components": {
      "default": [],
