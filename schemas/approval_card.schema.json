        "component": {
          "enum": [
            "scale",
            "orientation",
            "grounding",
            "pivot"
          ],
          "title": "Component",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "component",
        "evidence",
        "confidence"
      ],
      "title": "NormalizationComponent",
      "type": "object"
    }
