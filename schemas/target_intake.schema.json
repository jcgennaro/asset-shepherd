{
  "$defs": {
    "AssetEndpoint": {
      "description": "User-confirmed next consumer for the prepared asset.",
      "enum": [
        "UNITY",
        "UNREAL",
        "GODOT",
        "OTHER"
      ],
      "title": "AssetEndpoint",
      "type": "string"
    },
    "AssetTargetUse": {
      "description": "User-confirmed destination for the uploaded asset.",
      "enum": [
        "STATIC_GAME_ASSET",
        "RIG_READY_CHARACTER",
        "PLAYABLE_CHARACTER"
      ],
      "title": "AssetTargetUse",
      "type": "string"
    },
    "AssetViewingUse": {
      "description": "User-facing viewing context used to derive a mesh-complexity budget.",
      "enum": [
        "CLOSE_UP_SHOWCASE",
        "NORMAL_GAMEPLAY",
        "SMALL_DISTANT_REPEATED"
      ],
      "title": "AssetViewingUse",
      "type": "string"
    },
    "TargetEvidenceSource": {
      "description": "Auditable source of one proposed target field.",
      "enum": [
        "EXPLICIT_USER_TEXT",
        "MODEL_INFERENCE",
        "USER_CLARIFICATION",
        "DETERMINISTIC_FALLBACK"
      ],
      "title": "TargetEvidenceSource",
      "type": "string"
    },
    "TargetFieldEvidence": {
      "additionalProperties": false,
      "description": "Concise evidence supporting one populated target field.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.8,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "field": {
          "enum": [
            "target_use",
            "endpoint",
            "target_dimensions_cm",
            "target_height_cm",
            "viewing_use"
          ],
          "title": "Field",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/TargetEvidenceSource"
        }
      },
      "required": [
        "field",
        "source",
        "confidence",
        "evidence"
      ],
      "title": "TargetFieldEvidence",
      "type": "object"
    }
  },
  "$id": "https://asset-shepherd.dev/schemas/v1/target_intake.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Minimum typed state required before Asset Shepherd may offer target confirmation.",
  "properties": {
    "analyzer_model": {
      "default": "explicit-text-v1",
      "maxLength": 120,
      "minLength": 1,
      "title": "Analyzer Model",
      "type": "string"
    },
    "analyzer_provider": {
      "default": "deterministic",
      "maxLength": 40,
      "minLength": 1,
      "title": "Analyzer Provider",
      "type": "string"
    },
    "asset_name": {
      "default": "Untitled asset",
      "maxLength": 48,
      "minLength": 2,
      "title": "Asset Name",
      "type": "string"
    },
    "description": {
      "maxLength": 600,
      "minLength": 12,
      "title": "Description",
      "type": "string"
    },
    "endpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetEndpoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "endpoint_detail": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 2,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint Detail"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TargetFieldEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "expected_piece_count": {
      "default": 1,
      "maximum": 64,
      "minimum": 1,
      "title": "Expected Piece Count",
      "type": "integer"
    },
    "expected_piece_count_evidence": {
      "default": "A single asset is normally expected as one semantic piece.",
      "maxLength": 160,
      "minLength": 1,
      "title": "Expected Piece Count Evidence",
      "type": "string"
    },
    "missing_fields": {
      "items": {
        "enum": [
          "target_use",
          "endpoint",
          "target_dimensions_cm",
          "target_height_cm",
          "viewing_use"
        ],
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "schema_version": {
      "default": 4,
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "target_dimensions_cm": {
      "anyOf": [
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Dimensions Cm"
    },
    "target_height_cm": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 100000.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Height Cm"
    },
    "target_use": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetTargetUse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "viewing_use": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetViewingUse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "description",
    "missing_fields"
  ],
  "title": "TargetIntakeContract",
  "type": "object"
}
