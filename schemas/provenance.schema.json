{
  "$defs": {
    "AgentCandidateReassessment": {
      "additionalProperties": false,
      "description": "Model judgment after comparing standardized source and candidate views.",
      "properties": {
        "candidate_satisfies_assessment": {
          "title": "Candidate Satisfies Assessment",
          "type": "boolean"
        },
        "candidate_views_used": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Views Used",
          "type": "array"
        },
        "comparison_views_used": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Comparison Views Used",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "maxLength": 500,
            "minLength": 4,
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "initiating_tool_call_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initiating Tool Call Id"
        },
        "reassessment_id": {
          "pattern": "^reassessment-[0-9a-f]{16}-v1$",
          "title": "Reassessment Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_assessment_id": {
          "pattern": "^assessment-[0-9a-f]{16}-v1$",
          "title": "Source Assessment Id",
          "type": "string"
        },
        "source_views_used": {
          "items": {
            "type": "string"
          },
          "title": "Source Views Used",
          "type": "array"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 12,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "reassessment_id",
        "source_assessment_id",
        "candidate_satisfies_assessment",
        "summary",
        "evidence",
        "confidence",
        "source_views_used",
        "candidate_views_used"
      ],
      "title": "AgentCandidateReassessment",
      "type": "object"
    },
    "AgentDisposition": {
      "description": "The workflow agent's evidence-backed next-step judgment.",
      "enum": [
        "ACCEPT",
        "REPAIR",
        "REPORT_ONLY",
        "NEEDS_CLARIFICATION",
        "RETURN_TO_CREATION_TOOL"
      ],
      "title": "AgentDisposition",
      "type": "string"
    },
    "AgentRepairAssessment": {
      "additionalProperties": false,
      "description": "One model-authored assessment bound to objective observations and a confirmed target.",
      "properties": {
        "assessment_id": {
          "pattern": "^assessment-[0-9a-f]{16}-v1$",
          "title": "Assessment Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "disposition": {
          "$ref": "#/$defs/AgentDisposition"
        },
        "evidence": {
          "items": {
            "maxLength": 500,
            "minLength": 4,
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "ground_to_y_zero": {
          "default": false,
          "title": "Ground To Y Zero",
          "type": "boolean"
        },
        "initiating_tool_call_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initiating Tool Call Id"
        },
        "pivot_target": {
          "default": "PRESERVE",
          "enum": [
            "PRESERVE",
            "BOUNDS_CENTER",
            "FOOTPRINT_CENTER_BOTTOM"
          ],
          "title": "Pivot Target",
          "type": "string"
        },
        "rename_invalid_display_names": {
          "default": false,
          "title": "Rename Invalid Display Names",
          "type": "boolean"
        },
        "rotation_axis": {
          "anyOf": [
            {
              "enum": [
                "X",
                "Y",
                "Z"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Axis"
        },
        "rotation_degrees": {
          "default": 0,
          "enum": [
            -180,
            -90,
            0,
            90,
            180
          ],
          "title": "Rotation Degrees",
          "type": "integer"
        },
        "scale_to_confirmed_height": {
          "default": false,
          "title": "Scale To Confirmed Height",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "semantic_height_axis": {
          "anyOf": [
            {
              "enum": [
                "X",
                "Y",
                "Z"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Height Axis"
        },
        "source_views_used": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Views Used",
          "type": "array"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 12,
          "title": "Summary",
          "type": "string"
        },
        "weld_identical_vertices": {
          "default": false,
          "title": "Weld Identical Vertices",
          "type": "boolean"
        }
      },
      "required": [
        "assessment_id",
        "disposition",
        "summary",
        "evidence",
        "confidence"
      ],
      "title": "AgentRepairAssessment",
      "type": "object"
    },
    "AssetEndpoint": {
      "description": "User-confirmed next consumer for the prepared asset.",
      "enum": [
        "UNITY",
        "UNREAL",
        "GODOT",
        "OTHER"
      ],
      "title": "AssetEndpoint",
      "type": "string"
    },
    "AssetIntentProvenance": {
      "additionalProperties": false,
      "description": "Immutable user-confirmed target story bound to one inspection job.",
      "properties": {
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "confirmed_at": {
          "format": "date-time",
          "title": "Confirmed At",
          "type": "string"
        },
        "confirmed_story": {
          "maxLength": 1000,
          "minLength": 20,
          "title": "Confirmed Story",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetEndpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "endpoint_detail": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Detail"
        },
        "expected_piece_count": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Expected Piece Count",
          "type": "integer"
        },
        "expected_piece_count_evidence": {
          "default": "A single asset is normally expected as one semantic piece.",
          "maxLength": 160,
          "minLength": 1,
          "title": "Expected Piece Count Evidence",
          "type": "string"
        },
        "intent_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Intent Id",
          "type": "string"
        },
        "intent_version": {
          "default": 2,
          "enum": [
            1,
            2,
            3
          ],
          "title": "Intent Version",
          "type": "integer"
        },
        "original_description": {
          "maxLength": 600,
          "minLength": 12,
          "title": "Original Description",
          "type": "string"
        },
        "target_dimensions_cm": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "exclusiveMinimum": 0.0,
                  "maximum": 100000.0,
                  "type": "number"
                },
                {
                  "exclusiveMinimum": 0.0,
                  "maximum": 100000.0,
                  "type": "number"
                },
                {
                  "exclusiveMinimum": 0.0,
                  "maximum": 100000.0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Dimensions Cm"
        },
        "target_height_cm": {
          "exclusiveMinimum": 0.0,
          "maximum": 100000.0,
          "title": "Target Height Cm",
          "type": "number"
        },
        "target_use": {
          "$ref": "#/$defs/AssetTargetUse"
        }
      },
      "required": [
        "intent_id",
        "original_description",
        "target_use",
        "target_height_cm",
        "confirmed_story",
        "confirmed_at",
        "canonical_sha256"
      ],
      "title": "AssetIntentProvenance",
      "type": "object"
    },
    "AssetTargetUse": {
      "description": "User-confirmed destination for the uploaded asset.",
      "enum": [
        "STATIC_GAME_ASSET",
        "RIG_READY_CHARACTER",
        "PLAYABLE_CHARACTER"
      ],
      "title": "AssetTargetUse",
      "type": "string"
    },
    "ConversationTurnRecord": {
      "additionalProperties": false,
      "description": "Immutable link from one completed repair turn to the next user-requested turn.",
      "properties": {
        "agent_assessment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Assessment Id"
        },
        "candidate_reassessment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Reassessment Id"
        },
        "continuation_feedback": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Continuation Feedback",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "result_zip_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Zip Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "turn_index": {
          "minimum": 0,
          "title": "Turn Index",
          "type": "integer"
        },
        "verification_state": {
          "$ref": "#/$defs/VerificationState"
        }
      },
      "required": [
        "turn_index",
        "source_sha256",
        "output_sha256",
        "plan_id",
        "verification_state",
        "result_zip_sha256",
        "continuation_feedback"
      ],
      "title": "ConversationTurnRecord",
      "type": "object"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "description": "Authorization or rejection of one candidate repair.",
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/DecisionValue"
        },
        "interrupt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interrupt Id"
        },
        "source": {
          "$ref": "#/$defs/DecisionSource"
        }
      },
      "required": [
        "candidate_id",
        "decision",
        "source",
        "decided_at"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "DecisionSource": {
      "description": "Source of a repair authorization.",
      "enum": [
        "POLICY",
        "USER_APPROVAL_FILE",
        "USER_INTERACTIVE"
      ],
      "title": "DecisionSource",
      "type": "string"
    },
    "DecisionValue": {
      "description": "Recorded authorization outcome.",
      "enum": [
        "AUTO_AUTHORIZED",
        "APPROVED",
        "REJECTED"
      ],
      "title": "DecisionValue",
      "type": "string"
    },
    "ExecutedAction": {
      "additionalProperties": false,
      "description": "One repair action recorded in provenance.",
      "properties": {
        "authorization": {
          "$ref": "#/$defs/DecisionValue"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/RepairKind"
        }
      },
      "required": [
        "candidate_id",
        "kind",
        "finding_ids",
        "authorization"
      ],
      "title": "ExecutedAction",
      "type": "object"
    },
    "JsonValue": {},
    "ProfilePolicyProvenance": {
      "additionalProperties": false,
      "description": "Frozen identity and derivation record for one job's project policy.",
      "properties": {
        "base_preset_id": {
          "title": "Base Preset Id",
          "type": "string"
        },
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "explicit_overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Explicit Overrides",
          "type": "object"
        },
        "frozen_profile_id": {
          "title": "Frozen Profile Id",
          "type": "string"
        },
        "policy_family_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Family Id"
        },
        "profile_version": {
          "const": 1,
          "title": "Profile Version",
          "type": "integer"
        },
        "rule_sources": {
          "additionalProperties": {
            "enum": [
              "CONFIRMED_INTENT",
              "DERIVED_INTENT",
              "FAMILY_DEFAULT",
              "USER_OVERRIDE"
            ],
            "type": "string"
          },
          "title": "Rule Sources",
          "type": "object"
        }
      },
      "required": [
        "frozen_profile_id",
        "base_preset_id",
        "explicit_overrides",
        "profile_version",
        "canonical_sha256"
      ],
      "title": "ProfilePolicyProvenance",
      "type": "object"
    },
    "RepairKind": {
      "description": "Registered version-1 repair operations.",
      "enum": [
        "RENAME_NODE",
        "RENAME_MESH",
        "NORMALIZATION_TRANSFORM",
        "WELD_IDENTICAL_VERTICES"
      ],
      "title": "RepairKind",
      "type": "string"
    },
    "VerificationState": {
      "description": "Contracted final verification state.",
      "enum": [
        "PASSED_PROJECT_READY",
        "PASSED_WITH_REMAINING_WARNINGS",
        "FAILED",
        "BLOCKED"
      ],
      "title": "VerificationState",
      "type": "string"
    }
  },
  "$id": "https://asset-shepherd.dev/schemas/v1/provenance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Source, authorization, software, and timing provenance.",
  "properties": {
    "agent_assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentRepairAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "application_version": {
      "title": "Application Version",
      "type": "string"
    },
    "asset_intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetIntentProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate_reassessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentCandidateReassessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "commit_sha": {
      "title": "Commit Sha",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "conversation_turn_index": {
      "default": 0,
      "minimum": 0,
      "title": "Conversation Turn Index",
      "type": "integer"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/DecisionRecord"
      },
      "title": "Decisions",
      "type": "array"
    },
    "executed_actions": {
      "items": {
        "$ref": "#/$defs/ExecutedAction"
      },
      "title": "Executed Actions",
      "type": "array"
    },
    "library_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Library Versions",
      "type": "object"
    },
    "output_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Sha256"
    },
    "prior_turns": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConversationTurnRecord"
      },
      "title": "Prior Turns",
      "type": "array"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "profile_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfilePolicyProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile_version": {
      "const": 1,
      "title": "Profile Version",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "source_sha256",
    "output_sha256",
    "profile_id",
    "profile_version",
    "application_version",
    "commit_sha",
    "library_versions",
    "executed_actions",
    "decisions",
    "started_at",
    "completed_at"
  ],
  "title": "Provenance",
  "type": "object"
}
