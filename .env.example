ASSET_SHEPHERD_INTAKE_PROVIDER=bedrock-converse
ASSET_SHEPHERD_INTAKE_MODEL=moonshotai.kimi-k2.5

ASSET_SHEPHERD_MODEL_PROVIDER=bedrock-converse
ASSET_SHEPHERD_MODEL_ID=moonshotai.kimi-k2.5
ASSET_SHEPHERD_AWS_REGION=us-east-1
AWS_PROFILE=asset-shepherd
ASSET_SHEPHERD_RUN_LIVE=0

# The Bedrock Converse upload screen allowlists Kimi K2.5, Mistral Large 3,
# Qwen3 VL 235B, and Nova 2 Lite. It persists the selected model per asset.
# Nova may also be selected explicitly without its legacy provider alias:
# ASSET_SHEPHERD_INTAKE_MODEL=us.amazon.nova-2-lite-v1:0
# ASSET_SHEPHERD_MODEL_ID=us.amazon.nova-2-lite-v1:0
# ASSET_SHEPHERD_INTAKE_REASONING=medium
# ASSET_SHEPHERD_WORKFLOW_REASONING=medium

# Pending Luna Responses alternative (not part of the Converse UI allowlist):
# ASSET_SHEPHERD_INTAKE_PROVIDER=bedrock
# ASSET_SHEPHERD_MODEL_PROVIDER=bedrock
# ASSET_SHEPHERD_INTAKE_MODEL=us.openai.gpt-5.6-luna
# ASSET_SHEPHERD_MODEL_ID=us.openai.gpt-5.6-luna
# ASSET_SHEPHERD_INTAKE_REASONING=xhigh
# ASSET_SHEPHERD_WORKFLOW_REASONING=xhigh

# Optional direct-OpenAI development adapter only; not used when both providers above are bedrock.
OPENAI_API_KEY=
